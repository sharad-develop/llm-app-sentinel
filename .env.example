# Copy to .env and edit as needed.
# All values are optional — defaults are shown.

# Request validation
CITADEL_MAX_PROMPT_LENGTH=8192
CITADEL_CONTROL_CHARS_PATTERN=\x00-\x08\x0b\x0c\x0e-\x1f\x7f

# Normalization
CITADEL_INVISIBLE_CHARS_PATTERN=​-‏  ‪-‮⁠-⁤
CITADEL_MAX_SPACE_RUN=2
CITADEL_MAX_NEWLINE_RUN=3

# Rule checks
CITADEL_RULES_FILE=rules/default.yaml
CITADEL_BASE64_BLOB_PATTERN=[A-Za-z0-9+/=]{40,}
CITADEL_HEX_BLOB_PATTERN=(?:[0-9a-fA-F]{2}){20,}
CITADEL_MAX_ENCODED_RATIO=0.4
CITADEL_MIN_BLOB_LENGTH=40

# Classifier
CITADEL_CLASSIFIER_MODEL=gravitee-io/Llama-Prompt-Guard-2-86M-onnx
CITADEL_DISABLE_CLASSIFIER=false
CITADEL_CLASSIFIER_THRESHOLD_MEDIUM=0.50
CITADEL_CLASSIFIER_THRESHOLD_HIGH=0.90
